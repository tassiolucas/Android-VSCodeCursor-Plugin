{
  "name": "android-studio-experience",
  "displayName": "Android Studio Experience",
  "description": "Android Studio workflow for VS Code / Cursor (module selection, Android project tree, build variants, run, logcat, debug, preview and keymap) on top of JetBrains Kotlin LSP, which owns Gradle sync and code analysis.",
  "version": "0.4.0",
  "publisher": "ase-dev",
  "license": "Apache-2.0",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Keymaps", "Other"],
  "extensionDependencies": ["JetBrains.kotlin-server"],
  "activationEvents": [
    "onLanguage:kotlin",
    "onLanguage:java",
    "workspaceContains:settings.gradle.kts",
    "workspaceContains:settings.gradle"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Android Studio Experience",
      "properties": {
        "ase.autoReload": {
          "type": "boolean",
          "default": true,
          "description": "Ask kotlin-lsp to reload the Gradle project when the module flags file, *.gradle.kts or libs.versions.toml change."
        },
        "ase.profile.moduleFlagsFile": {
          "type": "string",
          "default": "local.properties",
          "markdownDescription": "File (relative to the workspace root) holding module flags in the `group.path/to/module=true|false|auto` format."
        },
        "ase.profile.defaultFlagsFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional defaults file with the same flag format. Used only when `moduleFlagsFile` has no valid flag."
        },
        "ase.profile.alwaysIncluded": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {},
          "markdownDescription": "Modules always included by the Gradle settings, as `{ \":gradle:path\": \"relative/dir\" }`."
        },
        "ase.profile.appModules": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "Application modules available to Run/Debug/Preview (e.g. `[\":app\"]`). The first one is the default."
        },
        "ase.profile.variants": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["debug"],
          "markdownDescription": "Build variants offered by the variant selector (e.g. `[\"debug\", \"freeDebug\"]`). The first one is the default."
        },
        "ase.adb.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `adb`. Empty = `$ANDROID_HOME/platform-tools/adb`, then `sdk.dir` from `local.properties`, then `adb` on PATH."
        },
        "ase.debug.port": {
          "type": "number",
          "default": 8700,
          "description": "Local TCP port forwarded to the app JDWP socket when attaching the debugger."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        { "id": "ase", "title": "Android", "icon": "$(device-mobile)" }
      ]
    },
    "views": {
      "ase": [
        { "id": "ase.androidProject", "name": "Project" }
      ]
    },
    "commands": [
      { "command": "ase.reloadProject",       "title": "Reload Gradle Project (kotlin-lsp)", "category": "ASE", "icon": "$(sync)" },
      { "command": "ase.lspDiagnostics",      "title": "kotlin-lsp Diagnostics",            "category": "ASE" },
      { "command": "ase.openKotlinLspIssues", "title": "Report Issue to kotlin-lsp",        "category": "ASE" },
      { "command": "ase.selectModules",       "title": "Select Modules",                    "category": "ASE", "icon": "$(checklist)" },
      { "command": "ase.refreshTree",         "title": "Refresh Android Project",           "category": "ASE", "icon": "$(refresh)" },
      { "command": "ase.selectVariant",       "title": "Select Build Variant",              "category": "ASE" },
      { "command": "ase.selectAppModule",     "title": "Select App Module",                 "category": "ASE" },
      { "command": "ase.assemble",            "title": "Build (assemble selected variant)", "category": "ASE" },
      { "command": "ase.selectDevice",        "title": "Select Device",                     "category": "ASE" },
      { "command": "ase.runApp",              "title": "Run App",                           "category": "ASE", "icon": "$(play)" },
      { "command": "ase.logcat",              "title": "Show Logcat",                       "category": "ASE" },
      { "command": "ase.debugApp",            "title": "Debug App (attach)",                "category": "ASE", "icon": "$(debug-alt)" },
      { "command": "ase.runComposePreview",   "title": "Run Compose Preview on Device",     "category": "ASE" }
    ],
    "menus": {
      "view/title": [
        { "command": "ase.selectModules", "when": "view == ase.androidProject", "group": "navigation@1" },
        { "command": "ase.reloadProject", "when": "view == ase.androidProject", "group": "navigation@2" },
        { "command": "ase.refreshTree",   "when": "view == ase.androidProject", "group": "navigation@3" }
      ],
      "editor/title": [
        { "command": "ase.runApp",   "when": "resourceLangId == kotlin", "group": "navigation@1" },
        { "command": "ase.debugApp", "when": "resourceLangId == kotlin", "group": "navigation@2" }
      ]
    },
    "keybindings": [
      { "command": "ase.selectModules", "key": "ctrl+alt+a", "mac": "cmd+alt+a" },
      { "command": "ase.reloadProject", "key": "ctrl+shift+o", "mac": "cmd+shift+o", "when": "!editorTextFocus" },
      { "command": "ase.runApp",        "key": "shift+f10",    "mac": "ctrl+r" },
      { "command": "ase.debugApp",      "key": "shift+f9",     "mac": "ctrl+d" },
      {
        "key": "ctrl+p", "mac": "cmd+p",
        "command": "-workbench.action.quickOpen",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "editor.action.triggerParameterHints",
        "key": "ctrl+p", "mac": "cmd+p",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "editor.action.revealDefinition",
        "key": "ctrl+b", "mac": "cmd+b",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "editor.action.goToImplementation",
        "key": "ctrl+alt+b", "mac": "cmd+alt+b",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "editor.action.goToTypeDefinition",
        "key": "ctrl+shift+b", "mac": "cmd+shift+b",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "editor.action.referenceSearch.trigger",
        "key": "alt+f7", "mac": "alt+f7",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "workbench.action.gotoSymbol",
        "key": "ctrl+f12", "mac": "cmd+f12",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "editor.action.showHover",
        "key": "ctrl+q", "mac": "ctrl+j",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "editor.showTypeHierarchy",
        "key": "ctrl+h", "mac": "ctrl+h",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "editor.showCallHierarchy",
        "key": "ctrl+alt+h", "mac": "ctrl+alt+h",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "editor.action.rename",
        "key": "shift+f6", "mac": "shift+f6",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "editor.action.formatDocument",
        "key": "ctrl+alt+l", "mac": "cmd+alt+l",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "editor.action.organizeImports",
        "key": "ctrl+alt+o", "mac": "ctrl+alt+o",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      },
      {
        "command": "editor.action.smartSelect.expand",
        "key": "ctrl+w", "mac": "alt+up",
        "when": "editorTextFocus && (editorLangId == kotlin || editorLangId == java)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "npx vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.30.0",
    "typescript": "^5.4.0"
  }
}
